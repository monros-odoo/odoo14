<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document">
        <xpath expr="//table/thead/tr" position="replace">
            <tr>
                <th name="th_sl_no" class="text-left">Sl.No.</th>
                <th name="th_description" class="text-left">Description</th>
                <th name="th_quantity" class="text-right">Quantity</th>
                <th name="th_priceunit" class="text-right">Unit Price</th>
                <th name="th_discount" t-if="display_discount" class="text-right" groups="product.group_discount_per_so_line">
                    <span>Disc.%</span>
                </th>
                <!--                <th name="th_taxes" class="text-right">Taxes</th>-->
                <th name="th_subtotal" class="text-right">
                    <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>
                    <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>
                </th>
            </tr>
        </xpath>

        <xpath expr="//t[@t-foreach='doc.order_line']" position="replace">
            <t t-set="sl_no" t-value="0"/>
            <t t-foreach="doc.order_line" t-as="line">
                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                    <t t-set="sl_no" t-value="sl_no+1"/>
                    <t t-if="not line.display_type">
                        <td name="td_sl_no"><span t-esc="sl_no"/></td>
                        <td name="td_name"><span t-field="line.name"/></td>
                        <td name="td_quantity" class="text-right">
                            <span t-field="line.product_uom_qty"/>
                            <span t-field="line.product_uom"/>
                        </td>
                        <td name="td_priceunit" class="text-right">
                            <span t-field="line.price_unit"/>
                        </td>
                        <td t-if="display_discount" class="text-right" groups="product.group_discount_per_so_line">
                            <span t-field="line.discount"/>
                        </td>
                        <!--                        <td name="td_taxes" class="text-right">-->
                        <!--                            <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_id))"/>-->
                        <!--                        </td>-->
                        <td name="td_subtotal" class="text-right o_price_total">
                            <span t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                            <span t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                        </td>
                    </t>
                    <t t-if="line.display_type == 'line_section'">
                        <td name="td_sl_no"><span t-esc="sl_no"/></td>
                        <td name="td_section_line" colspan="99">
                            <span t-field="line.name"/>
                        </td>
                        <t t-set="current_section" t-value="line"/>
                        <t t-set="current_subtotal" t-value="0"/>
                    </t>
                    <t t-if="line.display_type == 'line_note'">
                        <td name="td_note_line" colspan="99">
                            <span t-field="line.name"/>
                        </td>
                    </t>
                </tr>

                <t t-if="current_section and (line_last or doc.order_line[line_index+1].display_type == 'line_section')">
                    <tr class="is-subtotal text-right">
                        <td name="td_section_subtotal" colspan="99">
                            <strong class="mr16">Subtotal</strong>
                            <span
                                    t-esc="current_subtotal"
                                    t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'
                            />
                        </td>
                    </tr>
                </t>
            </t>
        </xpath>
        <xpath expr="//div[@id='total']" position="attributes">
            <attribute name="t-attf-class">''</attribute>
        </xpath>
        <xpath expr="//div[@id='total']/div[1]" position="attributes">
            <attribute name="t-att-style">'float:right;'</attribute>
            <attribute name="t-attf-class">'ml-auto'</attribute>
        </xpath>
        <xpath expr="//tr[hasclass('border-black')]/td[@name='td_amount_untaxed_label']" position="replace">
            <td name="td_amount_untaxed_label"><strong>Total Before Discount</strong></td>
        </xpath>
        <xpath expr="//p[@id='fiscal_position_remark']" position="after">
            <br/>
            <div style="width:100%;margin-top:50px;" id="prepared_received_div">
                <div style="float:left;margin-left:50px;" id="prepared_div">
                    <p style="font-weight:bold;padding-left:15px;">
                        Prepared By:
                    </p>
                    <p style="padding-top:40px;">-------------------------</p>
                </div>
                 <div style="float:right;margin-right:50px;" id="received_div">
                    <p style="font-weight:bold;padding-left:15px;">
                        Received By:
                    </p>
                      <p style="padding-top:40px;">-------------------------</p>
                </div>
            </div>
        </xpath>
    </template>

<!--    de_document_quantity_total - report inherit-->
    <template id="report_saleorder_document_de" inherit_id="de_document_quantity_total.report_saleorder_document_inherit">
        <xpath expr="//tr[@t-if='doc.tot_products']" position="attributes">
            <attribute name="t-att-style">'display:none;'</attribute>
        </xpath>
        <xpath expr="//tr[@t-if='doc.tot_qty']" position="attributes">
            <attribute name="t-att-style">'display:none;'</attribute>
        </xpath>
        <xpath expr="//div[@id='total']" position="inside">
            <div style="float:left">
                <table class="table table-sm">
                    <tr class="border-black o_total" t-if="doc.tot_products">
                        <td name="td_total_pdt_label" style="padding-top:20px;"><strong>Total Products</strong></td>
                        <td class="text-right" style="padding-top:20px;"><span t-field="doc.tot_products"/></td>
                    </tr>
                    <tr class="border-black o_total" t-if="doc.tot_qty">
                        <td name="td_total_qty_label"><strong>Total Qty</strong></td>
                        <td class="text-right"><span t-field="doc.tot_qty"/></td>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>
</odoo>