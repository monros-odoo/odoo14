<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_stock_production_lot_print_new_label">
            <style>
                 html, body {
                    height: 99%;
                }
                table {
                    border-collapse: collapse;
                }
                span {
                    margin: 0 !important;
                }
                th, td {
<!--                    border: 1px solid #000;-->
                }
            </style>
            <!--            <style>-->
            <!--                *{-->
            <!--                margin:0px !important;-->
            <!--&lt;!&ndash;                                        padding:0 !important;&ndash;&gt;-->
            <!--                margin-left: 1% !important;-->
            <!--                margin-top: 1% !important;-->
            <!--                margin-bottom: 1% !important;-->
            <!--                margin-right: 1% !important;-->
            <!--                }-->
            <!--            </style>-->
            <div class="oe_title" style="width: 111%; margin-left: -8px !important; padding: 0 3px;">
                <table cellpadding="0" cellspacing="0" style="font-family:'Times New Roman' !important;font-size:3px; width: 100%;">
                    <tr>
                        <td colspan="2" style="font-size: 6px; font-weight: 600; width: 75%;">
                            <span t-field="doc.company_id.product_label_name"/>
                        </td>
                        <td rowspan="2" style="width: 25%; text-align: right;">
                            <img style="width:25px;" t-att-src="image_data_uri(doc.product_id.qr_code)"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" style="vertical-align: middle !important;">
                            <table cellpadding="0" cellspacing="0" style="width: 100%;">
                                <tr>
                                    <td style="font-size: 8px; font-weight: 600; width: 30%;">
                                        <span>P<span t-field="doc.product_id.power"/></span>
                                    </td>
                                    <td style="font-weight: 600; font-size: 8px;text-align: right;width: 70%;">
                                        <span t-field="doc.product_id.product_name_label"/>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
                <table cellpadding="0" cellspacing="0" style="font-family:'Times New Roman' !important;font-size: 6px; width: 100%;">
                    <tr>
                        <td>
                            <span>DIA &amp;nbsp;<span t-esc="doc.product_id.dia"/></span>
                        </td>
                        <td>
                            <span>EXP <span t-esc="doc.expiration_date.strftime('%d/%m/%Y')"/></span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span>BC &amp;nbsp;&amp;nbsp;<span t-field="doc.product_id.bc"/></span>
                        </td>
                        <td>
                            <span>LOT <span t-field="doc.name"/></span>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" style="text-align:center;">
                            <span t-field="doc.product_id.barcode"
                                  t-options="{'widget': 'barcode','img_style': 'width:75%; height:10px;'}"/>
                            <br/>
                            <span style="font-weight: bold; font-size: 7px;" t-esc="doc.product_id.barcode"/>
                        </td>
                    </tr>
                </table>
            </div>
        </template>

        <template id="report_stock_production_label">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="kp_label_print.report_stock_production_lot_print_new_label"/>
                </t>
            </t>
        </template>
    </data>
</odoo>





